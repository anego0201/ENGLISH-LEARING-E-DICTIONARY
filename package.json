{
  "name": "english-learning-e-dic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "assets:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "assets:sample-pdf": "node scripts/generate-sample-pdf.mjs",
    "build:dict": "node --disable-warning=ExperimentalWarning scripts/build-dictionary.mjs --input data/raw/dictionary.sample.csv",
    "build:db": "node --disable-warning=ExperimentalWarning scripts/build-dictionary.mjs",
    "prepare:assets": "npm run assets:pdfjs && npm run build:dict && npm run assets:sample-pdf",
    "predev": "npm run prepare:assets",
    "dev": "vite",
    "prebuild": "npm run prepare:assets",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:worker": "node scripts/test-lexicon-worker.mjs",
    "test:reader": "node scripts/test-reader-engine.mjs",
    "test": "npm run test:worker && npm run test:reader",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wa-sqlite": "github:rhashimoto/wa-sqlite#v1.1.2",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
